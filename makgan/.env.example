# Supabase 프로젝트 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 매직링크가 돌아올 주소(배포 주소). 비우면 요청의 Origin을 쓴다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 푸시 알림(15단계) — 키 만들기: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# 서버 전용: 크론이 알림을 모아 보낼 때 씀(Supabase → Project Settings → API → service_role). 절대 공개 금지
SUPABASE_SERVICE_ROLE_KEY=
# /api/cron/send-alerts 보호용 임의 문자열(Vercel Cron은 Authorization: Bearer <CRON_SECRET>로 호출)
CRON_SECRET=
