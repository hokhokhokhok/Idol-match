{
  "name": "magok-academy",
  "version": "0.1.0",
  "private": true,
  "description": "마곡 뮤지컬 학원 찾기 — 초·중등 보컬·댄스·연기·뮤지컬 학원과 강사 경력 비교",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'lib/**/*.test.ts'",
    "check:data": "node scripts/check-data.ts && node scripts/check-data.ts data/sample",
    "import": "node scripts/import-csv.ts",
    "test:e2e": "DATA_DIR=data/sample next build && node scripts/e2e.mjs && echo \"(out/는 예시 데이터 빌드 — 배포 전 npm run build로 다시 빌드)\""
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^16.4.2",
    "react": "19.2",
    "react-dom": "19.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
